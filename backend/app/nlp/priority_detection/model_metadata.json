{
    "model": "ExtraTreesClassifier",
    "task": "Priority Detection",
    "dataset": "issues.csv",
    "target": "issue_priority",
    "excluded_target_value": "unknown",
    "issue_key": [
        "issue_proj",
        "issue_num"
    ],
    "feature_columns": [
        "issue_proj",
        "issue_type",
        "created_year",
        "created_month",
        "created_dayofweek",
        "created_hour",
        "issue_contr_count"
    ],
    "n_estimators": 400,
    "class_weight": "balanced",
    "min_samples_leaf": 2,
    "random_state": 42,
    "train_rows": 26128,
    "test_rows": 6533,
    "accuracy": 0.7325883973672126,
    "macro_f1": 0.3965741092697084,
    "weighted_f1": 0.7634661907780012,
    "classes": [
        "Blocker",
        "High",
        "Highest",
        "Low",
        "Lowest",
        "Medium"
    ]
}